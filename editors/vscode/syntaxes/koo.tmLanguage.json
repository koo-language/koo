{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Koo",
  "scopeName": "source.koo",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#calls" },
        { "include": "#operators" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.koo", "match": "///.*$" },
        { "name": "comment.line.double-slash.koo", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.koo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.double.koo",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        { "name": "string.quoted.other.raw.koo", "begin": "`", "end": "`" }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.koo", "match": "\\\\(?:[nrt0\\\\\"'{]|u\\{[0-9a-fA-F]+\\})" },
        { "name": "invalid.illegal.escape.koo", "match": "\\\\." }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.koo",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.koo" } },
      "end": "(:[^{}\"]*)?(\\})",
      "endCaptures": {
        "1": { "name": "constant.other.format.koo" },
        "2": { "name": "punctuation.section.interpolation.end.koo" }
      },
      "patterns": [{ "include": "#code" }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.koo", "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b" },
        { "name": "constant.numeric.duration.koo", "match": "\\b(?:[0-9][0-9_]*(?:h|min|s|ms|us|ns))+\\b" },
        { "name": "constant.numeric.hex.koo", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.koo", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.integer.koo", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(?:\\([^)]*\\)\\s*)?(?:([A-Z][A-Za-z0-9]*)(?:<[^>]*>)?\\.)?([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.koo" },
            "2": { "name": "entity.name.type.koo" },
            "3": { "name": "entity.name.function.koo" }
          }
        },
        {
          "match": "\\b(type|enum|error|interface|actor)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.koo" },
            "2": { "name": "entity.name.type.koo" }
          }
        },
        {
          "match": "\\b(import)\\s+([a-z0-9_/.-]+)",
          "captures": {
            "1": { "name": "keyword.control.import.koo" },
            "2": { "name": "entity.name.namespace.koo" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.koo", "match": "\\b(?:if|else|match|for|in|while|break|continue|return|fail|defer|scope|select|spawn)\\b" },
        { "name": "keyword.operator.word.koo", "match": "\\b(?:and|or|not|is|as)\\b" },
        { "name": "storage.modifier.koo", "match": "\\b(?:var|take|pub|distinct|resource|unsafe)\\b" },
        { "name": "keyword.declaration.koo", "match": "\\b(?:fn|type|enum|error|interface|actor|import)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.koo", "match": "\\b(?:true|false|none)\\b" },
        { "name": "variable.language.self.koo", "match": "\\bself\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.koo", "match": "\\b(?:int|float|bool|byte|string)\\b" },
        { "name": "entity.name.type.koo", "match": "\\b[A-Z][A-Za-z0-9]*\\b" }
      ]
    },
    "calls": {
      "patterns": [
        { "name": "support.function.builtin.koo", "match": "\\b(?:print|panic)(?=\\()" },
        { "name": "entity.name.function.call.koo", "match": "\\b[a-z_][a-z0-9_]*(?=\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.koo", "match": "->|=>" },
        { "name": "keyword.operator.assignment.koo", "match": ":=|\\+=|-=|\\*=|/=|=(?!=)" },
        { "name": "keyword.operator.comparison.koo", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.range.koo", "match": "\\.\\.=?" },
        { "name": "keyword.operator.arithmetic.koo", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.error.koo", "match": "[?!|]" }
      ]
    }
  }
}
