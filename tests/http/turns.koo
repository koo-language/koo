// A server of one process whose handlers and whose actors want the connections of one
// small pool (`a_pool_is_shared_by_handlers_and_actors` in the tests). A method of an
// actor that a handler asks runs on the handlers' own thread and cannot be left, and
// one that an actor was told runs on a thread of its own: neither may keep the
// handlers from their turn, nor be kept waiting for a handler that cannot go on.
import std/http
import std/os
import std/sql
import std/sql/postgres

actor Asker {
    db: sql.Pool

    fn one() -> string {
        match db.query_row("select 1 as n") {
            row => return "{row.int("n") else -1}"
            ! e => return "{e.kind}"
        }
    }

    // Statements one after another, each a hundredth of a second, on whatever thread
    // runs what the actor was told.
    fn churn(times: int) {
        for i in 0..times {
            db.exec("select pg_sleep(0.01)") else 0
        }
    }
}

fn main() ! sql.Error | http.Error {
    size := int.parse(os.env("POOL") else "") else 1
    db := postgres.connect(os.env("DATABASE_URL") else "", pool: size, wait: 3s)?
    askers := [Asker.start(db: db), Asker.start(db: db), Asker.start(db: db)]
    var app := http.App.new()
    app.get("/ping", req -> http.text("pong\n"))
    // Holds a connection of the pool for so long.
    app.get("/slow/:seconds", req -> {
        db.exec("select pg_sleep({float.parse(req.param("seconds")) else 1.0})")?
        return http.text("slept\n")
    })
    app.get("/quick", req -> http.text("{db.query_row("select 2 as n")?.int("n")?}\n"))
    app.get("/actor", req -> http.text("{askers[0].one()}\n"))
    app.get("/churn/:times", req -> {
        for asker in askers {
            asker.send.churn(int.parse(req.param("times")) else 1)
        }
        return http.text("told\n")
    })
    app.serve(workers: 1)?
}
