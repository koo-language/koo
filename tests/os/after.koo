// A server that has work of its own to finish after it has been told to stop
// (`a_program_is_told_to_stop`): it asked whether it was to stop before it served, so
// the signal ends nothing for it, before the server, during it or after; and after the
// server has ended, the answer is that it was told.
import std/http
import std/os
import std/time

fn main() ! http.Error {
    // It asks before it serves; or, told to by the test, only from a handler, which
    // with several workers is in another process than this one.
    if (os.env("ASK") else "main") == "main" {
        print("asked: {os.stopping()}")
    }
    var app := http.App.new()
    app.get("/ping", req -> http.text("pong\n"))
    app.get("/stopping", req -> http.text("{os.stopping()}\n"))
    app.serve(workers: int.parse(os.env("WORKERS") else "") else 1)?
    // (One that asked only from a handler does not ask again here: to ask now would
    // be a first asking of this process's own, and it is the handler's that counts.)
    if (os.env("ASK") else "main") == "main" {
        print("the server ended; told to stop: {os.stopping()}")
    } else {
        print("the server ended")
    }
    // What is left to do takes a while, and a second signal comes meanwhile.
    for step in 0..6 {
        time.sleep(100ms)
    }
    print("what was left was done")
}
