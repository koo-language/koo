// The server that `client.koo` asks (`a_program_asks_another_server` in
// compiler/koo/tests/programs.rs). It listens where PORT says.

import std/encoding
import std/http
import std/os
import std/time

error Refused

type Reading = { value: float }

actor Visits {
    var seen: int = 0

    fn one_more() -> int {
        seen += 1
        return seen
    }

    // A method that may fail and has nothing to return when it does not.
    fn allowed(n: int) ! Refused {
        if n < 0 { fail Refused }
    }

    // Bytes go to another process and back as they are.
    fn same_bytes(bytes: [byte]) -> [byte] {
        return bytes
    }

    // What it is given, as it was given: a float goes to another process and back.
    fn same(x: float) -> float {
        return x
    }

    // The first actor a server starts, taking its time.
    fn linger(millis: int) -> int {
        time.sleep(1ms * millis)
        return seen
    }
}

// Actors that handlers start: one for each name that is asked for, kept by another
// so that every worker finds the one there is.
actor Rooms {
    var rooms: [string: Visits] = [:]

    fn find(name: string) -> Visits? {
        return rooms[name]
    }

    fn keep(name: string, room: Visits) -> Visits {
        if there := rooms[name] {
            return there
        }
        rooms[name] = room
        return room
    }
}

// What it is started with cannot go from one process to another.
actor Pinned {
    at: (int, int)

    fn sum() -> int {
        (a, b) := at
        return a + b
    }
}

// An actor that takes its time, and lets four messages wait.
@mailbox(4)
actor Printer {
    var printed: int = 0

    fn page(n: int) {
        time.sleep(100ms)
        printed += 1
    }

    fn count() -> int {
        return printed
    }
}

// An actor that takes as long as it is asked to, and one of whose methods panics.
actor Sloth {
    var naps: int = 0

    fn nap(millis: int) -> int {
        time.sleep(1ms * millis)
        naps += 1
        return naps
    }

    fn trip(n: int) -> int {
        empty: [int] = []
        return empty[n]
    }

    // As deep as it is asked to go, in the actor's own method.
    fn dive(n: int) -> int {
        return depth(n)
    }
}

type Echo = { method: string, path: string, body: string, agent: string, kind: string, token: string }

// A program's own function may have a name the library has too.
fn json<T>(value: T) -> string {
    return "<{value}>"
}

// As deep as it is asked to go: deep enough, and no stack holds it.
fn depth(n: int) -> int {
    if n == 0 {
        return 0
    }
    return depth(n - 1) + 1
}

// The same, printing as it goes: it runs out of stack with the printing in its hands.
fn noisy(n: int) -> int {
    if n == 0 {
        return 0
    }
    print("level")
    return noisy(n - 1) + 1
}

fn main() ! http.Error {
    visits := Visits.start()
    port := int.parse(os.env("PORT") else "") else 8080
    var app := http.App.new()
    // One type read from a request and from another server's answer, in one handler.
    app.post("/relay", req -> {
        asked: Echo = req.json()?
        reply := http.post("http://127.0.0.1:{port}/echo", asked.to_json(), timeout: 5s)?
        told: Echo = reply.json()?
        return http.text("{json(told.method)} {asked.path} {told.body.len == asked.to_json().len}\n")
    })
    // Twenty messages at once to an actor with room for four: whether there was room
    // is the actor's to say, whichever process the handler is in.
    printer := Printer.start()
    // What is told to an actor that is stopped is dropped, and nobody waits.
    stopped := Printer.start()
    stopped.stop()
    app.get("/gone", req -> {
        stopped.send.page(1)
        return http.text("{stopped.try_send.page(2)}\n")
    })
    app.get("/try", req -> {
        var accepted := 0
        for n in 0..20 {
            if printer.try_send.page(n) {
                accepted += 1
            }
        }
        return http.text("{accepted}\n")
    })
    // Six that wait for room, and are all there when they are counted.
    app.get("/send", req -> {
        before := printer.count()
        for n in 0..6 {
            printer.send.page(n)
        }
        var after := printer.count()
        while after < before + 6 {
            time.sleep(10ms)
            after = printer.count()
        }
        return http.text("{after - before}\n")
    })
    app.get("/noisy/:n", req -> http.text("{noisy(int.parse(req.param("n")) else 0)}\n"))
    app.get("/depth/:n", req -> http.text("{depth(int.parse(req.param("n")) else 0)}\n"))
    rooms := Rooms.start()
    app.get("/room/:name", req -> {
        name := req.param("name")
        room := rooms.find(name) else rooms.keep(name, Visits.start())
        return http.text("{room.one_more()}\n")
    })
    app.get("/pinned", req -> http.text("{Pinned.start(at: (1, 2)).sum()}\n"))
    // After an actor in another process is asked, what is written as JSON is for
    // anyone again: a float that is not a number is `null`.
    app.get("/after", req -> {
        visits.allowed(1)?
        zero := float.parse(req.query("zero") else "0") else 0.0
        return http.json(Reading { value: zero / zero })
    })
    app.get("/bytes", req -> http.text("{visits.same_bytes("a\u{ff}".bytes())}\n"))
    app.get("/ratio", req -> {
        done := float.parse(req.query("done") else "0") else 0.0
        total := float.parse(req.query("total") else "0") else 0.0
        return http.text("{visits.same(done / total)}\n")
    })
    // A handler that waits, and then asks an actor, which is in another process when
    // the server has more than one worker.
    app.get("/visit", req -> {
        time.sleep(500ms)
        return http.text("visit {visits.one_more()}\n")
    })
    app.any("/echo", req -> http.json(Echo {
        method: req.method,
        path: req.path,
        body: req.body(),
        agent: req.header("User-Agent") else "",
        kind: req.header("Content-Type") else "",
        token: req.header("X-Token") else "",
    }))
    // An actor that takes its time is waited for by the handler that asked it, and by
    // nobody else: not by the other handlers of its worker, nor by the other actors.
    sloth := Sloth.start()
    app.get("/sloth/:millis", req -> http.text("{sloth.nap(int.parse(req.param("millis")) else 0)}\n"))
    app.get("/trip", req -> http.text("{sloth.trip(3)}\n"))
    app.get("/dive/:n", req -> http.text("{sloth.dive(int.parse(req.param("n")) else 0)}\n"))
    app.get("/linger/:millis", req -> http.text("{visits.linger(int.parse(req.param("millis")) else 0)}\n"))
    app.post("/through", req -> http.bytes(visits.same_bytes(req.bytes())))
    app.get("/slow", req -> {
        time.sleep(2s)
        return http.text("late\n")
    })
    app.get("/nap", req -> {
        time.sleep(300ms)
        return http.text("rested\n")
    })
    // Bodies that are not text, and answers that send the client elsewhere.
    app.get("/blob", req -> http.bytes(encoding.from_hex("00ff0a") else []))
    app.post("/mirror", req -> http.bytes(req.bytes(), content_type: "image/png"))
    app.get("/moved", req -> http.redirect("/echo"))
    app.get("/moved/twice", req -> http.redirect("/moved"))
    app.get("/loop", req -> http.redirect("/loop"))
    app.post("/see-other", req -> http.redirect("/echo", status: 303))
    app.post("/kept", req -> http.redirect("/echo", status: 307))
    app.get("/dir/page", req -> http.redirect("other?x=1"))
    app.get("/dir/other", req -> http.text("beside, with {req.query("x") else "nothing"}"))
    app.get("/a/b/up", req -> http.redirect("../seen?via=up#top"))
    app.get("/a/seen", req -> http.text("seen by way of {req.query("via") else "nothing"}"))
    app.get("/a/next", req -> http.redirect("/a/seen?via=http://example.invalid/back"))
    app.get("/a/query", req -> {
        if page := req.query("page") { return http.text("page {page}") }
        return http.redirect("?page=2")
    })
    app.get("/", req -> http.redirect("/whoami"))
    app.get("/whoami", req -> http.text("{req.header("Authorization") else "nobody"}, {req.header("X-Token") else "no token"}"))
    app.get("/same", req -> http.redirect("/whoami"))
    app.get("/away", req -> http.redirect("http://127.0.0.1:{port}/whoami"))
    app.get("/list", req -> http.json([3, 1, 2]))
    app.get("/table", req -> http.json(["nails": 1.5, "glue": 4.0]))
    app.get("/big", req -> http.text("0123456789".repeat(300000)))
    app.get("/none", req -> http.status(204))
    app.get("/missing", req -> http.status(404, "nothing here\n"))
    app.get("/cookie", req -> http.text("ok").cookie("a", "1").cookie("b", "2"))
    app.serve(port: port, workers: int.parse(os.env("WORKERS") else "") else 2)?
}
