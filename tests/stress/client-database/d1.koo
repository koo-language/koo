import std/sql/postgres

fn try(url: string) {
    match postgres.connect(url, wait: 2s) {
        db => {
            match db.query_row("select current_user as u, current_database() as d, inet_server_port() as p, current_setting('application_name') as a") {
                row => print("OK   {url} -> {row}")
                ! e => print("QERR {url} -> {e.kind}: {e}")
            }
        }
        ! e => print("ERR  {url} -> {e.kind}: {e}")
    }
}

fn main() {
    pw := "PASSWORD"
    try("postgres://postgres:{pw}@localhost:54329/postgres")
    try("postgresql://postgres:{pw}@127.0.0.1:54329/postgres")
