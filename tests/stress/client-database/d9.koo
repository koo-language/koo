// Two pools, each of one connection. A statement that waits for a connection of one
// pool is not woken when that connection comes back, if a statement waiting for the
// other pool is woken in its place.
import std/os
import std/sql
import std/sql/postgres
import std/time

actor Worker {
    db: sql.Pool
    var took: int = 0

    // Holds the pool's one connection for so long.
    fn hold(seconds: float) {
        db.query("select pg_sleep({seconds})") else e => {
            print("hold failed: {e}")
            return
        }
    }

    // A statement that takes no time, once it has a connection.
    fn quick() {
        started := time.uptime()
        match db.query("select 1") {
            rows => {}
            ! e => print("quick failed: {e.kind}: {e}")
        }
        took = (time.uptime() - started).millis()
    }

    fn millis() -> int {
        return took
    }
}

fn main() ! sql.Error {
    url := os.env("KOO_TEST_POSTGRES") else ""
    a := postgres.connect(url, pool: 1, wait: 10s)?
    b := postgres.connect(url, pool: 1, wait: 10s)?
    hold_a := Worker.start(db: a)
    hold_b := Worker.start(db: b)
    wait_a := Worker.start(db: a)
    wait_b := Worker.start(db: b)
    hold_a.send.hold(1.0)
    hold_b.send.hold(3.0)
    time.sleep(200ms)
    wait_b.send.quick()
    time.sleep(200ms)
    wait_a.send.quick()
    print("pool A was free after 1 s; its statement, sent at 0.4 s, waited {wait_a.millis()} ms (about 600 expected)")
    print("pool B was free after 3 s; its statement, sent at 0.2 s, waited {wait_b.millis()} ms (about 2800 expected)")
}
