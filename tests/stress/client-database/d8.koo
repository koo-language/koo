import std/os
import std/sql/postgres
import std/time

fn main() {
    started := time.uptime()
    match postgres.connect(os.args().get(0) else "", wait: 2s) {
        db => {
            print("connected after {(time.uptime() - started).millis()} ms")
            match db.query("select 1") {
                rows => print("rows {rows.len}")
                ! e => print("query: {e.kind}: {e}")
            }
        }
        ! e => print("connect failed after {(time.uptime() - started).millis()} ms: {e.kind}: {e}")
    }
    print("ended after {(time.uptime() - started).millis()} ms")
}
