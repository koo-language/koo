// The server that `check.py` drives: one kind of actor, 256 of them, asked and told
// from the handlers of a server.
import std/http
import std/os
import std/time

fn depth(n: int) -> int {
    if n <= 0 { return 0 }
    return depth(n - 1) + 1
}

actor Counter {
    var count: int = 0
    var told: int = 0

    fn next() -> int {
        count += 1
        return count
    }

    fn seen() -> int {
        return count
    }

    fn nap(millis: int) -> int {
        time.sleep(1ms * millis)
        count += 1
        return count
    }

    fn echo(text: string) -> string {
        return text
    }

    fn big(n: int) -> string {
        return "x".repeat(n)
    }

    fn tell() {
        told += 1
    }

    fn was_told() -> int {
        return told
    }

    // One past the end of a list: a panic in the actor's own method.
    fn slip(n: int) -> int {
        few := [1, 2, 3]
        return few[n]
    }

    // As deep as it is asked to go, until the stack runs out.
    fn dive(n: int) -> int {
        return depth(n)
    }
}

// An actor of another kind, so that there are two.
actor Names {
    var names: [string] = []

    fn add(name: string) -> int {
        names.push(name)
        return names.len
    }

    fn all() -> [string] {
        return names
    }
}

fn num(req: http.Request, name: string) -> int {
    return int.parse(req.param(name)) else 0
}

fn main() ! http.Error {
    var counters: [Counter] = []
    for i in 0..256 {
        counters.push(Counter.start())
    }
    names := Names.start()
    var app := http.App.new()
    app.get("/ping", req -> http.text("pong\n"))
    app.get("/names", req -> http.text("{names.add("n")} {names.all().len}\n"))
    // A handler that waits, and lets its worker go on meanwhile.
    app.get("/wait/:ms", req -> {
        time.sleep(1ms * num(req, "ms"))
        return http.text("waited\n")
    })
    app.get("/next/:i", req -> http.text("{counters[num(req, "i") % 256].next()}\n"))
    app.get("/seen/:i", req -> http.text("{counters[num(req, "i") % 256].seen()}\n"))
    app.get("/nap/:i/:ms", req -> http.text("{counters[num(req, "i") % 256].nap(num(req, "ms"))}\n"))
    app.post("/echo/:i", req -> http.text(counters[num(req, "i") % 256].echo(req.body())))
    app.get("/big/:i/:n", req -> http.text(counters[num(req, "i") % 256].big(num(req, "n"))))
    app.get("/tell/:i", req -> {
        counters[num(req, "i") % 256].send.tell()
        return http.text("told\n")
    })
    app.get("/told/:i", req -> http.text("{counters[num(req, "i") % 256].was_told()}\n"))
    app.get("/slip/:i", req -> http.text("{counters[num(req, "i") % 256].slip(7)}\n"))
    app.get("/dive/:i", req -> http.text("{counters[num(req, "i") % 256].dive(100000000)}\n"))
    // A handler that computes, and keeps its worker meanwhile.
    app.get("/spin/:n", req -> {
        var work := 0
        for i in 0..num(req, "n") {
            work = (work + i) % 1000003
        }
        return http.text("{work}\n")
    })
    port := int.parse(os.env("PORT") else "") else 39800
    app.serve(port: port, workers: int.parse(os.env("WORKERS") else "") else 4)?
}
