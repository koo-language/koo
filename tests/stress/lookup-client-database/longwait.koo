import std/http
import std/os
import std/sql
import std/sql/postgres
import std/time

actor Holder {
    db: sql.Pool
    fn hold() {
        db.transaction(tx -> { tx.exec("select pg_sleep(3)")? }) else e => print("holder: {e}")
    }
    fn done() -> bool { return true }
}

fn main() ! sql.Error {
    db := postgres.connect(os.env("PG") else "", pool: 1, wait: 9223372036s)?
    h := Holder.start(db: db)
    h.send.hold()
    time.sleep(300ms)
    started := time.uptime()
    match db.query_row("select 7 as n") {
        row => print("ran after {(time.uptime() - started).millis()} ms")
        ! e => print("{e.kind}: {e} after {(time.uptime() - started).millis()} ms")
    }
    h.done()
    match http.get("http://127.0.0.1:" + (os.env("SINK") else "39803") + "/", timeout: 9223372036s) {
        reply => print("answered {reply.status}")
        ! e => print("{e.kind}: {e} after {(time.uptime() - started).millis()} ms")
    }
}
