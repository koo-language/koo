import std/sql/postgres
import std/time

fn try(url: string) {
    started := time.uptime()
    match postgres.connect(url, pool: 1, wait: 1s) {
        db => {
            match db.query_row("select current_user as u, current_database() as d, inet_server_port() as p") {
                row => print("{url}: connected as {row.string("u") else "?"} to {row.string("d") else "?"} port {row.int("p") else 0}")
                ! e => print("{url}: connected, then {e}")
            }
        }
        ! e => print("{url}: {e.kind}: {e.message} [{(time.uptime() - started).millis()} ms]")
    }
}

