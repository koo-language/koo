import std/io
import std/os
import std/time
import std/random
import std/crypto

fn try_write(path: string) {
    match io.write_file(path, "data ✓\n") {
        _ => print("wrote {path}")
        ! e => print(e.message)
    }
    match io.read_file(path) {
        text => print("read {text.len} bytes from {path}")
        ! e => print(e.message)
    }
}

fn main() {
    print(os.args())
    now := time.now()
    print(now.year() >= 2025)
    print(now.unix() > 1700000000)
    before := time.uptime()
    time.sleep(250ms)
    took := (time.uptime() - before).millis()
    print(took >= 250 and took < 600)
    print(random.uuid().len)
    print(random.bytes(8).len)
    n := random.int(0, 10)
    print(n >= 0 and n < 10)
    x := random.float()
    print(x >= 0.0 and x < 1.0)
    kept := crypto.hash_password("secret")
    print(crypto.verify_password("secret", kept))
    print(crypto.verify_password("Secret", kept))
    print(kept.slice(0, 7))
    for path in ["/tmp/koo-hunt.txt", "/koo-hunt.txt", "/proc/version", "/dev/null", "/etc/hostname", "/nonexistent/dir/file", ""] {
        try_write(path)
    }
    print(os.env("HOME"))
    print(os.env("TZ"))
    print(os.env("PATH").is_some())
    line := io.read_line()
    print(line)
    rest := io.read_lines()
    print(rest.len)
}
