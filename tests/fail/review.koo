// Programs an independent review found to be wrongly accepted, or to crash the compiler.

type Wrap<T> = { v: T }
type Loop = { f: (Loop, int) }
type Key = { id: int }

fn (self: Key) hash() -> string { return "k" }

// A generic function that asks for itself with a larger type each time.
fn deeper<T>(x: T, n: int) -> int {
    if n == 0 { return 0 }
    return deeper(Wrap<T> { v: x }, n - 1) + 1
}

fn main() {
    print(deeper(1, 3))

    // The inside of a map or a set is its own.
    var m := ["a": 1]
    m.len = 3
    var s := Set<int>.from_list([1])
    s.len = 0
    x := Map<string, int> { _keys: [], _values: [], _live: [], _slots: [], _len: 5 }
    y := Map<string, int>._from_lists(["a"], [1])
    print(m._len)
    print(m == m)
    unit := [(): 1]

    n := 5
    print("{n:<>5} {1.5:.+1} {n:1000000} {1.5:.999}")
}
//! error `Loop` contains itself
//! error a method named `hash` takes nothing and returns `int`
//! error `deeper` is needed for a type nested more than 24 deep
//! error cannot assign to this expression
//! error cannot assign to this expression
//! error `[string: int]` cannot be built from its fields
//! error `Map` has no function `_from_lists`
//! error `[string: int]` has no field `_len`
//! error `==` is not defined for `[string: int]`
//! stderr maps and sets cannot be compared with `==` in this compiler yet
//! error a map or set of `()` is not supported by this compiler yet
//! error the format `<>5` cannot be used here
