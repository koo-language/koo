enum Light { Red, Amber, Green }
enum Shape { Circle { r: float }, Rect { w: float, h: float }, Dot }

fn main() {
    light := Light.Red
    match (light, true) {
        (Light.Green, true) => print("go")
        (Light.Amber, _) => print("slow")
        (Light.Red, false) => print("stop")
    }
    shape := Shape.Dot
    match (shape, 1) {
        (Shape.Dot, _) => print("dot")
        (Shape.Circle { r }, 1) => print("one circle")
    }
    nested := ((true, false), Light.Green)
    match nested {
        ((true, _), Light.Green) => print("a")
        ((false, true), _) => print("b")
        ((_, false), Light.Red) => print("c")
    }
    match (1, "x") {
        (1, "x") => print("both")
        (_, "y") => print("y")
    }
    a: int? = 1
    match (a, true) {
        (none, true) => print("none")
    }
}

enum Why { Slow, Gone, Other }

error Missing
error Failed { why: Why, message: string }

fn find(id: int) -> int ! Missing | Failed {
    if id == 0 { fail Missing }
    if id < 0 { fail Failed { why: Why.Gone, message: "below zero" } }
    return id
}

// An error that no arm names is missing as the error it is, and not as the values of
// its fields; one that is named for some of its values is missing for the rest.
fn errors() {
    match find(1) {
        id => print(id)
        ! Missing => print("missing")
    }
    match find(1) {
        id => print(id)
        ! Missing => print("missing")
        ! Failed { why: Why.Slow, .. } => print("slow")
    }
    match find(1) {
        ! e => print("failed")
    }
}

//! error this `match` does not cover `(Red, true)`, `(Green, false)`
//! error this `match` does not cover `(Circle, _)`, `(Rect, _)`
//! error this `match` does not cover `((true, true), Red)`, `((true, true), Amber)`, `((true, false), Amber)`, `((false, false), Amber)`, `((false, false), Green)`
//! error this `match` does not cover the remaining values: add a `_` arm
//! error this `match` does not cover `(none, false)`, `(a value, _)`
//! error this `match` does not cover `! Failed`
//! error this `match` does not cover `! Failed { .. }`
//! error this `match` does not cover the success value
