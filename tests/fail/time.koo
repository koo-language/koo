// What cannot be done with durations and times (Section 10.6).
import std/time

type Time = { hour: int }

fn main() {
    a := time.now()
    b := time.now()
    print(a + b)
    print(1s + 1)
    print(1s * 2s)
    print(a * 2)
    forever := 300000000h
    var gap := 1s
    gap += a
    var when := a
    when *= 2
    print(-a)
    print(gap._ns)
    made := Duration { _ns: 5 }
}

//! error `Time` is already declared
//! error `+` is not defined for `Time` and `Time`
//! error `+` is not defined for `Duration` and `int`
//! error `*` is not defined for `Duration` and `Duration`
//! error `*` is not defined for `Time` and `int`
//! error this duration is longer than a `Duration` can be
//! error this gives a `Time`, which cannot be assigned to a `Duration`
//! error this operator is not defined for `Time` and `int`
//! error `-` is not defined for `Time`
//! error `Duration` has no field `_ns`
//! error `Duration` cannot be built from its fields
