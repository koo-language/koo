enum Shape {
    Circle { r: float }
    Square { side: float }
    Dot
}

fn area(shape: Shape) -> float {
    match shape {
        Circle { r } => { return r * r * 3.14 }
        Square { side } => { return side * side }
    }
}

fn name(shape: Shape) -> string {
    return match shape {
        Circle { .. } => "circle"
        Square { side } => 4
        Dot => "dot"
    }
}

fn partial(shape: Shape) -> float {
    match shape {
        Circle => { return 1.0 }
        Square { } => { return 2.0 }
        Triangle => { return 3.0 }
        _ => { return 0.0 }
    }
}

fn numbers(n: int, s: string?) -> int {
    a := match n {
        0 => 1
        1 => 2
    }
    b := match s {
        none => 0
    }
    c := if n > 0 { 1 }
    return a + b + c
}

fn main() {
    shape := Dot
    other := Shape.Hexagon
    third := Shape.Circle
}
