//= {"name":"saw","count":1,"state":"fresh"}
//= bolt 9 Fresh
//= 7
//= hat
//= 4
//= item nail [small]
//= yes
//= 5 after 2 steps of 1
//= stock's util
//= prices' util
//= two kept
//= just 3
