// What a package does not offer is not to be had from outside it (Section 4.6), and
// a package does not see the names of the program that imports it.

import ./stock
import ./unused
import ./nowhere

fn mine() -> int {
    return 1
}

type Mine = { n: int }

fn main() {
    print(stock.bounded(1))
    print(stock.limit)
    item := stock.Item { name: "a", _tag: "t" }
    print(item._tag)
    print(item.secret())
    print(stock.Item.make())
    print(pkg_stock__label(1))
    print(stock.nothing(1))
    match item {
        stock.Item { name, _tag } => print(name)
    }
    match stock.Mode.On {
        stock.Mode.On => print("on")
        stock.Mode.Off => print("off")
    }
    print(stock.wrong())
    print(stock.Box<int>.sealed(3).open())
    count := stock.Count.start()
    count.reset()
    print(count.total())
    match stock.moved() {
        stock.Event.Moved { to, _by } => print(to)
        _ => print("gone")
    }
    print(stock.theirs())
    print(Other.make())
    print(item.hush())
    tally := stock.Tally.start()
    tally.send.wipe(5)
    print(stock.job()._run())
    match stock.level() {
        Low => print("low")
        _ => print("other")
    }
    remade: stock.Item = made()
    print(item.echo(3))
}

type Hashable = { n: int }

fn made<T>() -> T {
    return T.make()
}

// Another name for a type of the package is the type still: it is given no methods
// here, and what the package keeps of it is kept from this name too.
type Other = stock.Item

fn (self: Other) shout() -> string {
    return "mine now"
}

// A variant written bare is suggested from the program's own enum, and never from one
// that a package keeps to itself (`stock` has a `Level` with a `High`).
enum Phase { High }

fn phase() {
    print(High)
}

// A name of the program's with `__` in it is said as written, and the rest of the
// message as the program writes it; and so is one that only looks like a package's.
fn spelled(it__em: stock.Item) {
    n: int = it__em
    odd := Odd { other: 2 }
    print(odd.other)
}

type Odd = { pkg_nothing__here: int, other: int }
