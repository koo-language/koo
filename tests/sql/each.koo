// The rows of a query read a batch at a time, each given to a function, for an answer
// too large to hold whole. Run against a PostgreSQL server whose address is in
// KOO_TEST_POSTGRES (see `a_database_answers_queries` in compiler/koo/tests/programs.rs).

import std/os
import std/sql
import std/sql/postgres

error TooMany { at: int }

fn main() ! sql.Error {
    db := postgres.connect(os.env("KOO_TEST_POSTGRES") else "")?
    var total := 0
    seen := db.each("select n from generate_series(1, {25000}) as n", row -> {
        total += row.int("n")?
    }, batch: 4000)?
    print("{seen} rows, total {total}")
    print(db.each("select 1 as n where false", row -> print(row))?)
    // A body that fails ends the reading, and the failure is the answer.
    var read := 0
    match db.each("select n from generate_series(1, 100) as n", row -> {
        read += 1
        if read == 7 { fail TooMany { at: read } }
    }, batch: 3) {
        n => print("all {n}")
        ! e: TooMany => print("stopped at {e.at}, having read {read}")
        ! e: sql.Error => print(e.message)
    }
    // In a transaction, with other statements beside it, and one reading inside another.
    pairs := db.transaction(tx -> {
        var pairs := 0
        tx.each("select a from generate_series(1, 3) as a", outer -> {
            tx.each("select b from generate_series(1, 2) as b", inner -> {
                pairs += 1
            })?
        })?
        return pairs
    })?
    print(pairs)
    match db.each("select nothing from nowhere", row -> print(row)) {
        n => print(n)
        ! e => print(e.kind)
    }
}

//= 25000 rows, total 312512500
//= 0
//= stopped at 7, having read 7
//= 6
//= Syntax
