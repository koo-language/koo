// A statement that would wait for a connection for ever is told so, or waits a time
// that has an end.

import std/os
import std/sql
import std/sql/postgres
import std/time

actor Holder {
    db: sql.Pool

    fn hold(length: int) {
        db.transaction(tx -> {
            tx.exec("select pg_sleep({length})")?
        }) else e => print("holder: {e}")
    }

    fn done() -> bool {
        return true
    }
}

fn main() ! sql.Error {
    url := os.env("KOO_TEST_POSTGRES") else ""
    db := postgres.connect(url, pool: 2, wait: 1s)?

    // The easy slip: the pool where the transaction was meant.
    one := postgres.connect(url, pool: 1)?
    started := time.uptime()
    one.transaction(tx -> {
        one.exec("select 1")?
    }) else e => print("{e.kind}: {e.message.slice(0, 44)}...")
    print((time.uptime() - started) < 1s)

    // Every connection in use by others: the wait has an end.
    a := Holder.start(db: db)
    b := Holder.start(db: db)
    a.send.hold(3)
    b.send.hold(3)
    time.sleep(500ms)
    began := time.uptime()
    match db.exec("select 1") {
        n => print("ran")
        ! e => print("{e.kind}: {e}")
    }
    waited := time.uptime() - began
    print(waited >= 900ms and waited < 2500ms)
    a.done()
    b.done()
    print(db.query_row("select 7 as n")?.int("n")?)
}

//= Other: every connection of the pool is in a transac...
//= true
//= Timeout: every connection to the database was in use for 1000 ms, and the pool has 2
//= true
//= 7
