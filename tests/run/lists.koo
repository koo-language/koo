type Item = { name: string, qty: int }

fn sum(xs: [int]) -> int {
    var total := 0
    for x in xs { total += x }
    return total
}

fn squares(n: int) -> [int] {
    var out: [int] = []
    for i in 1..=n { out.push(i * i) }
    return out
}

fn main() {
    xs := [3, 1, 2]
    print(xs)
    print(xs.len)
    print(xs[0] + xs[2])
    print(sum(squares(10)))

    var ys := xs
    ys.push(9)
    ys[0] = 30
    print(xs)
    print(ys)
    ys.swap(0, 3)
    print(ys)
    print(ys.pop())
    print(ys.get(0))
    print(ys.get(99))
    last := ys.pop() else 0
    print(last)
    ys.clear()
    print(ys.pop())
    print(ys.len)

    var items: [Item] = []
    items.push(Item { name: "pen", qty: 2 })
    items.push(Item { name: "ink", qty: 1 })
    var names := ""
    for item in items { names += item.name + " " }
    print(names)
    items[1].qty += 10
    print(items)
    kept := items
    items[0].name = "pencil"
    print(kept[0].name)
    print(items[0].name)

    var grid: [[int]] = []
    for r in 0..3 {
        var row: [int] = []
        for c in 0..3 { row.push(r * 3 + c) }
        grid.push(row)
    }
    grid[1][1] = 100
    print(grid)

    var flags := List<bool>.with_size(5)
    flags[2] = true
    print(flags)
    zeros := List<float>.with_size(2)
    print(zeros)

    // The loop walks the list as it was.
    var growing := [1, 2, 3]
    for x in growing {
        if x < 3 { growing.push(x * 10) }
    }
    print(growing)

    words := ["b", "a"]
    var joined := ""
    for w in words { joined += w }
    print(joined)
    print([[1], [], [2, 3]])
}
