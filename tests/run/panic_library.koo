// A panic inside a function of the library is reported at the line of the program that
// called the function, and not at a line of the library.

fn main() {
    var names := ["ada", "bob"]
    print(names.len)
    names.remove(9)
}

//= 2
//! exit 101
//! stderr panic: index out of range
//! stderr at
//! stderr panic_library.koo:7
