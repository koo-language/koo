max_retries := 3
scale: float = 2.5

fn main() {
    a := 7
    b := 2
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(-a / b)
    print(-a % b)
    print(a % -1)
    print(1_000_000 * max_retries)
    print(0xFF + 0b101)
    x := 3.0
    print(x / 2.0)
    print(x * scale)
    print(float.from(a) / 2.0)
    print(a < b)
    print(a >= b and not (a == b) or false)
    print(-9223372036854775808)
    print(a.max(b) - a.min(b))
    print((0 - a).abs())
    print(a.bit_and(b).bit_or(8).shl(2))
    print(2.0.sqrt())
    print((2.0 / 3.0).min(0.5))
    var total := 0
    total += 5
    total *= 3
    total -= 1
    total /= 2
    print(total)
    var f := 1.5
    f *= 2.0
    print(f)
    print(1.0e3)
    print(9223372036854775807.wrapping_add(1))
}
