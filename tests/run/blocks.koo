// Blocks, closures and the variables they share (Sections 5.4 and 5.7): programs that an
// independent review found to crash, to give wrong answers or to be wrongly rejected.

pub interface Shape {
    fn area() -> float
}
pub interface Named {
    fn name() -> string
}

type Circle = { r: float }
type Rect = { w: float, h: float }
fn (self: Circle) area() -> float { return 3.0 * self.r * self.r }
fn (self: Rect) area() -> float { return self.w * self.h }

type Cell<T> = { v: T }
fn (self: Cell<T>) name() -> string { return "cell" }
fn (self: Cell<T>) compare(other: Cell<T>) -> int { return 0 }

type Holder = { f: fn(var Holder) -> string, s: string }
type Box = { items: [string] }

fn difference(a: Shape, b: Shape) -> float { return a.area() - b.area() }
fn show_name<N: Named>(x: N) -> string { return x.name() }
fn id<T>(x: T) -> T { return x }
fn double(x: int) -> int { return x * 2 }
fn apply<A, B>(f: fn(A) -> B, a: A) -> B { return f(a) }
fn outer(g: fn(int) -> int) -> int { return apply(g, 1) }
fn plain(h: var Holder) -> string { return "plain" }
fn run(f: fn()) { f() }
fn run2(a: fn(fn()), b: fn()) { a(b) }
fn each2(items: [int], f: fn(int)) {
    for item in items { f(item) }
}
fn with_double(use: fn(fn(int) -> int) -> int) -> int {
    return use(x -> x * 2)
}
fn show(s: string, change: fn()) -> int {
    change()
    return s.len + s.to_upper().len
}
fn call_then_read(change: fn(), s: string) -> string {
    change()
    return s + "!"
}

fn main() {
    // A block that takes a function uses a variable of the function around it.
    n := 5
    print(with_double(g -> g(n)))

    // A closure that replaces the variable it is held in, while it runs.
    captured := "cap" + "tured"
    var f := (go: fn()) -> {
        go()
        print(captured)
    }
    f(() -> {
        f = (go: fn()) -> {}
    })
    var h := Holder { f: x -> {
        x = Holder { f: plain, s: "new" }
        return captured + "!"
    }, s: "old" }
    print((h.f)(var h))
    print(h.s)

    // Two blocks of one call share a variable: a copy one takes is a copy.
    var copy: [int] = []
    var xs: [int] = []
    run2(share -> {
        for i in 0..3 {
            xs.push(i)
            share()
        }
    }, () -> {
        if xs.len == 1 { copy = xs }
    })
    print(xs)
    print(copy)

    // A block that changes a variable another block has lent to a function.
    var s := "first" + " value"
    var total := 0
    run2(share -> {
        total += show(s, share)
        total += show(s, () -> share())
        print(call_then_read(share, s))
        share()
        print(s)
    }, () -> {
        s = "x" + "y"
    })
    print(total)
    var box := Box { items: ["a" + "b", "c"] }
    run2(share -> {
        for item in box.items {
            share()
            print(item)
        }
        print(show(box.items[0], share))
    }, () -> {
        box = Box { items: ["z" + "z"] }
    })
    print(box)
    var g := (k: int) -> k + s.len
    var seen := 0
    run2(share -> {
        seen = g(1)
        kept := g
        share()
        seen += kept(1) + g(1)
    }, () -> {
        g = (k: int) -> k * 100
    })
    print(seen)

    // An element or an entry assigned in a lambda, as its first use of the variable.
    var ys := [1, 2, 3]
    run(() -> {
        ys[0] = 0
    })
    print(ys)
    var counts: [string: int] = [:]
    ["a", "b"].each(w -> {
        counts[w] = 1
    })
    print(counts)
    var sum := 0
    each2([1, 2], (x -> sum += x))
    print(sum)

    // Function values in generic code, in lists and in maps.
    twice := id(double)
    print(twice(1))
    table: [string: fn(int) -> int] = ["d": double]
    print(table.len)
    var fs: [fn(int) -> int] = [double]
    fs.insert(0, double)
    print(fs.len)
    print(outer(x -> x + 1))

    // Two interface parameters, and methods declared on a generic type.
    c := Circle { r: 1.0 }
    r := Rect { w: 2.0, h: 3.0 }
    print(difference(c, r))
    print(difference(r, c))
    print(show_name(Cell<int> { v: 1 }))
    print(Cell<int> { v: 1 } < Cell<int> { v: 2 })
}
//= 10
//= captured
//= captured!
//= new
//= [0, 1, 2]
//= [0]
//= xy!
//= xy
//= 26
//= ab
//= c
//= 4
//= Box { items: ["zz"] }
//= 106
//= [0, 2, 3]
//= ["a": 1, "b": 1]
//= 3
//= 2
//= 1
//= 2
//= 2
//= -3.0
//= 3.0
//= cell
//= false
