// A client for Redis, and for what speaks as Redis does (Valkey, KeyDB, Dragonfly),
// written in Koo on `std/net`.
//
//     import ./redis
//
//     cache := redis.connect(os.env("REDIS_URL") else "redis://localhost:6379")?
//     cache.set("greeting", "hello", ttl: 60s)?
//     word := cache.get("greeting")?            // string?
//     hits := cache.incr("hits")?
//
// It is a package (Section 8.2): a program has it by having this directory beside its
// own files, or wherever its `import` says, and is offered what is `pub` here.
import std/encoding
import std/net

/// Why a command failed: the address is none; the server could not be reached, or
/// went away; it did not answer in time; it refused the command, and says why; or what
/// it said is not what a Redis says.
pub enum ErrorKind { Address, Connection, Timeout, Refused, Protocol }

pub error Error { kind: ErrorKind, message: string }

/// What a server answers to a command.
pub enum Reply {
    Nothing
    Text { value: string }
    Number { value: int }
    Items { items: [Reply] }
    Refusal { message: string }
}

/// A server, and how to speak to it. It is a value: the connections are kept by
/// `std/net`, as many as `pool` at a time for each process of the program.
pub type Client = {
    pool: net.Pool,
    user: string,
    database: int,
    timeout: Duration,
    /// The longest value that is read, in bytes: a server is not taken at its word
    /// for how much it is about to send.
    most: int,
    /// The password. It is no part of what the value is shown as.
    _password: string = "",
}

/// A server as text: where it is and who asks, without the password.
pub fn (self: Client) to_string() -> string {
    return "Redis {self.pool.address} database {self.database}{if self.user == "" { "" } else { " as {self.user}" }}"
}

/// `redis://[user:password@]host[:port][/database]`, where a password alone is written
/// `:password@`, and a character of either that an address has a use for, an `@` or a
/// `:` or a `/`, is written as `%` and its two hexadecimal digits. One command is sent
/// now, so that an address that leads nowhere, or a password that is wrong, is known at
/// once.
pub fn connect(url: string, pool: int = 10, timeout: Duration = 5s, most: int = 67108864) -> Client ! Error {
    rest := url.strip_prefix("redis://") else fail Error {
        kind: ErrorKind.Address,
        message: "the address of a Redis begins with `redis://`: `redis://user:password@host:6379/0`",
    }
    var who := ""
    var place := rest
    if (before, after) := cut_last(rest, "@") {
        who = before
        place = after
    }
    var user := who
    var password := ""
    if (name, secret) := who.cut(":") {
        user = name
        password = secret
    }
    // (A `+` is itself here, and not the space it stands for in a query.)
    user = encoding.from_url(user.replace("+", "%2B")) else fail Error {
        kind: ErrorKind.Address,
        message: "the user in the address of a Redis has a `%` that is not followed by two hexadecimal digits",
    }
    password = encoding.from_url(password.replace("+", "%2B")) else fail Error {
        kind: ErrorKind.Address,
        message: "the password in the address of a Redis has a `%` that is not followed by two hexadecimal digits",
    }
    if user != "" and password == "" {
        fail Error {
            kind: ErrorKind.Address,
            message: "the address of a Redis names the user `{user}` and no password: `redis://user:password@host`, or `redis://:password@host` for a password alone",
        }
    }
    var database := 0
    var host := place
    if (before, after) := place.cut("/") {
        host = before
        if after != "" {
            database = int.parse(after) else fail Error {
                kind: ErrorKind.Address,
                message: "`{after}` is not the number of a database",
            }
        }
    }
    if host == "" { host = "localhost" }
    // (An address of the new kind is in brackets, and has colons of its own.)
    if not host.contains(":") or host.ends_with("]") { host = "{host}:6379" }
    // The connections of this user and this database are kept apart from those of
    // any other: each is told who is asking and of which database when it is new, and
    // is what it was told from then on. (The password is no part of the name, which
    // anyone may print.)
    apart := "redis {database} {user}"
    connections := net.pool(host, size: pool, wait: timeout, name: apart) else e => fail from(e)
    server := Client { pool: connections, user, database, timeout, most, _password: password }
    server.command(["PING"])?
    return server
}

/// Sends a command, a word and what it is given, and returns what the server answers.
/// A command that the server refuses is a failure of the kind `Refused`.
///
/// A command is sent on whichever of the connections is free, and the next on
/// whichever is free then. So a command that changes what a connection means for what
/// is sent on it afterwards, `MULTI` or `SELECT` or `SUBSCRIBE`, is not sent this way,
/// and is refused here: whoever had the connection next would be answered as nobody
/// expects. Several commands that are to be done as one are given to `atomically`.
pub fn (self: Client) command(words: [string]) -> Reply ! Error {
    if words.len == 0 {
        fail Error { kind: ErrorKind.Refused, message: "a command has a name" }
    }
    name := words[0].to_upper()
    if changes_connection(name) {
        fail Error {
            kind: ErrorKind.Refused,
            message: "`{name}` changes what a connection means for whoever has it next, and is not sent with `command`",
        }
    }
    answer := self.pool.with(conn -> {
        greet(self, conn)?
        return ask(self, conn, words)?
    })
    match answer {
        reply => return accepted(reply)?
        ! e: Error => fail e
        ! e: net.Error => fail from(e)
    }
}

/// Does several commands as one, with no other client's command between two of them,
/// and returns what each answered. If the server refuses one as it is given, a name it
/// does not know, none is done. One that fails when it is done, a number added to what
/// is no number, does not undo the others, which is how a Redis is: it is a failure
/// here, of the kind `Refused`, that says which, so that it is not missed. (This is
/// `MULTI` and `EXEC`, on one connection.)
pub fn (self: Client) atomically(commands: [[string]]) -> [Reply] ! Error {
    for words in commands {
        if words.len == 0 or changes_connection(words[0].to_upper()) {
            fail Error {
                kind: ErrorKind.Refused,
                message: "a command that changes what a connection means is not one of several done as one",
            }
        }
    }
    answer := self.pool.with(conn -> {
        greet(self, conn)?
        accepted(ask(self, conn, ["MULTI"])?)?
        var refused := ""
        for words in commands {
            match ask(self, conn, words)? {
                Refusal { message } => {
                    if refused == "" { refused = message }
                }
                other => {}
            }
        }
        if refused != "" {
            accepted(ask(self, conn, ["DISCARD"])?)?
            return Reply.Refusal { message: refused }
        }
        return ask(self, conn, ["EXEC"])?
    })
    match answer {
        reply => {
            match accepted(reply)? {
                Items { items } => {
                    for i in 0..items.len {
                        match items[i] {
                            Refusal { message } => fail Error {
                                kind: ErrorKind.Refused,
                                message: "of {items.len} commands done as one, number {i + 1} failed, and the others were done: {message}",
                            }
                            other => {}
                        }
                    }
                    return items
                }
                other => fail odd("EXEC", other)
            }
        }
        ! e: Error => fail e
        ! e: net.Error => fail from(e)
    }
}

/// The value of a key, if it has one.
pub fn (self: Client) get(key: string) -> string? ! Error {
    match self.command(["GET", key])? {
        Text { value } => return value
        Nothing => return none
        other => fail odd("GET", other)
    }
}

/// Gives a key a value, for ever or for so long.
pub fn (self: Client) set(key: string, value: string, ttl: Duration = 0s) ! Error {
    if ttl > 0s {
        // (What is less than the least a Redis keeps time by is that least, and not
        // for ever.)
        millis := if ttl.millis() < 1 { 1 } else { ttl.millis() }
        self.command(["SET", key, value, "PX", "{millis}"])?
    } else {
        self.command(["SET", key, value])?
    }
}

/// Removes keys, and returns how many there were.
pub fn (self: Client) del(keys: [string]) -> int ! Error {
    var words := ["DEL"]
    for key in keys { words.push(key) }
    return number("DEL", self.command(words)?)?
}

/// Adds to the number a key holds, which is 0 if it holds none, and returns the sum.
pub fn (self: Client) incr(key: string, by: int = 1) -> int ! Error {
    return number("INCRBY", self.command(["INCRBY", key, "{by}"])?)?
}

/// Says how much longer a key is to be kept. Returns whether there is such a key.
pub fn (self: Client) expire(key: string, ttl: Duration) -> bool ! Error {
    return number("PEXPIRE", self.command(["PEXPIRE", key, "{if ttl > 0s and ttl.millis() < 1 { 1 } else { ttl.millis() }}"])?)? == 1
}

/// Puts values at the end of a list, and returns how long the list then is.
pub fn (self: Client) push(key: string, values: [string]) -> int ! Error {
    var words := ["RPUSH", key]
    for value in values { words.push(value) }
    return number("RPUSH", self.command(words)?)?
}

/// Takes the first value of a list, waiting for one as long as `wait` if the list is
/// empty; none if none came. (The time a command may take is added to it for the
/// answer, so that a wait of five seconds is not cut off at five.)
pub fn (self: Client) pop(key: string, wait: Duration = 0s) -> string? ! Error {
    if wait <= 0s {
        match self.command(["LPOP", key])? {
            Text { value } => return value
            Nothing => return none
            other => fail odd("LPOP", other)
        }
    }
    patient := Client {
        pool: self.pool,
        user: self.user,
        database: self.database,
        timeout: self.timeout + wait,
        most: self.most,
        _password: self._password,
    }
    seconds := wait.seconds()
    match patient.command(["BLPOP", key, "{seconds}"])? {
        Items { items } => {
            if items.len == 2 {
                match items[1] {
                    Text { value } => return value
                    other => fail odd("BLPOP", other)
                }
            }
            fail odd("BLPOP", Reply.Items { items })
        }
        Nothing => return none
        other => fail odd("BLPOP", other)
    }
}

// ---- what the file keeps to itself --------------------------------------------------------

/// What is said first on a connection on which nothing has been said: who is asking,
/// and of which database.
fn greet(server: Client, conn: net.Conn) ! Error {
    if not conn.fresh() { return }
    if server._password != "" {
        greeting := if server.user == "" { ["AUTH", server._password] } else { ["AUTH", server.user, server._password] }
        accepted(ask(server, conn, greeting)?)?
    }
    if server.database != 0 {
        accepted(ask(server, conn, ["SELECT", "{server.database}"])?)?
    }
}

/// Whether a command changes what its connection means for what is sent on it next.
fn changes_connection(name: string) -> bool {
    return ["MULTI", "EXEC", "DISCARD", "WATCH", "UNWATCH", "SELECT", "AUTH", "HELLO", "SUBSCRIBE", "PSUBSCRIBE", "SSUBSCRIBE", "UNSUBSCRIBE", "PUNSUBSCRIBE", "SUNSUBSCRIBE", "MONITOR", "QUIT", "RESET", "CLIENT"].contains(name)
}

/// The parts before and after the last occurrence of a separator.
fn cut_last(text: string, separator: string) -> (string, string)? {
    var found: (string, string)? = none
    var before := ""
    var rest := text
    while true {
        (head, tail) := rest.cut(separator) else { break }
        before = if found == none { head } else { before + separator + head }
        found = (before, tail)
        rest = tail
    }
    return found
}

fn from(e: net.Error) -> Error {
    kind := match e.kind {
        net.ErrorKind.Address => ErrorKind.Address
        net.ErrorKind.Timeout => ErrorKind.Timeout
        net.ErrorKind.TooLong => ErrorKind.Protocol
        net.ErrorKind.NotText => ErrorKind.Protocol
        _ => ErrorKind.Connection
    }
    return Error { kind, message: e.message }
}

fn protocol(what: string) -> Error {
    return Error { kind: ErrorKind.Protocol, message: "the server did not answer as a Redis does: {what}" }
}

fn odd(command: string, reply: Reply) -> Error {
    return protocol("to {command} it answered {reply}")
}

/// A refusal is a failure; anything else is the answer.
fn accepted(reply: Reply) -> Reply ! Error {
    match reply {
        Refusal { message } => fail Error { kind: ErrorKind.Refused, message }
        other => return other
    }
}

fn number(command: string, reply: Reply) -> int ! Error {
    match reply {
        Number { value } => return value
        other => fail odd(command, other)
    }
}

/// Writes a command and reads its answer.
fn ask(server: Client, conn: net.Conn, words: [string]) -> Reply ! Error {
    var said := "*{words.len}\r\n"
    for word in words {
        said += "${word.len}\r\n{word}\r\n"
    }
    conn.write(said, timeout: server.timeout) else e => fail from(e)
    return read(server, conn, 0)?
}

/// Reads one answer, which may have answers inside it, though not without end.
fn read(server: Client, conn: net.Conn, depth: int) -> Reply ! Error {
    line := conn.read_line(timeout: server.timeout) else e => fail from(e)
    if rest := line.strip_prefix("+") { return Reply.Text { value: rest } }
    if rest := line.strip_prefix("-") { return Reply.Refusal { message: rest } }
    if rest := line.strip_prefix(":") {
        value := int.parse(rest) else fail protocol("`{rest}` for a number")
        return Reply.Number { value }
    }
    if rest := line.strip_prefix("$") {
        count := int.parse(rest) else fail protocol("`{rest}` for a length")
        if count < 0 { return Reply.Nothing }
        if count > server.most {
            fail protocol("a value of {count} bytes, where the longest that is read is {server.most}")
        }
        data := conn.read_exact(count + 2, timeout: server.timeout) else e => fail from(e)
        value := string.from_bytes(data.slice(0, count)) else fail protocol("a value that is not text")
        return Reply.Text { value }
    }
    if rest := line.strip_prefix("*") {
        count := int.parse(rest) else fail protocol("`{rest}` for a count")
        if count < 0 { return Reply.Nothing }
        if count > 1000000 or depth >= 8 {
            fail protocol("{count} answers inside an answer, {depth} deep")
        }
        var items: [Reply] = []
        for i in 0..count {
            items.push(read(server, conn, depth + 1)?)
        }
        return Reply.Items { items }
    }
    fail protocol("a line that is none of the five kinds a Redis sends")
}
