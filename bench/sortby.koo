type Entry = { key: int, id: int }

fn main() {
    var seed := 7
    var entries: [Entry] = []
    for i in 0..1_500_000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        entries.push(Entry { key: seed % 100_000, id: i })
    }
    entries.sort_by((a, b) -> a.key < b.key)
    var check := 0
    for i in 0..entries.len {
        if i % 1000 == 0 { check += entries[i].key % 1000 + entries[i].id % 7 }
    }
    print(check)
}
