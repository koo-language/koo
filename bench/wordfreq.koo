fn main() {
    var seed := 42
    var counts: [string: int] = [:]
    for _ in 0..2_000_000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        word := "w{seed % 5000}"
        counts.update(word, 0, n -> n + 1)
    }
    var best := 0
    for (_, n) in counts {
        if n > best { best = n }
    }
    print("{counts.len} words, most frequent {best}")
}
